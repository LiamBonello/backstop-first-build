# The browser and API use the same origin by default.
# Leave this empty for local development and the recommended Render deployment.
VITE_API_BASE_URL=

# Optional server-side threat-intelligence adapter.
# Google Web Risk Lookup API:
# https://cloud.google.com/web-risk
GOOGLE_WEB_RISK_API_KEY=

# Browser-rendered fallback modes:
# 1 = conditional Chromium fallback when static evidence is incomplete
# force = always attempt Chromium rendering
# 0 = static HTML only
#
# Local development can use 1.
# The initial Render Free deployment uses 0 to keep memory/build usage low.
BACKSTOP_BROWSER_FALLBACK=1

# Local PostgreSQL. This matches docker-compose.yml.
# On Render, replace this with the pooled Neon PostgreSQL connection string.
DATABASE_URL=postgresql://backstop:backstop@127.0.0.1:55432/backstop
