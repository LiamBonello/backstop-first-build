# Leave empty during local development:
# Vite proxies /api to http://localhost:8787.
#
# Set this only when the scanner API is deployed
# on a different origin.

VITE_API_BASE_URL=

# Optional server-side threat-intelligence adapter.
# These are read only by the Node API, never by the browser bundle.
#
# Google Web Risk Lookup API:
# https://cloud.google.com/web-risk
GOOGLE_WEB_RISK_API_KEY=
#

# Browser-rendered fallback is enabled by default.
# Set to 0 to force static HTML scanning only.
BACKSTOP_BROWSER_FALLBACK=1
