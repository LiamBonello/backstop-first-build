# Leave empty during local development:
# Vite proxies /api to http://localhost:8787.
#
# Set this only when the scanner API is deployed
# on a different origin.

VITE_API_BASE_URL=

# Optional server-side threat-intelligence adapter.
# These are read only by the Node API, never by the browser bundle.
#
# Google Web Risk Lookup API:
# https://cloud.google.com/web-risk
GOOGLE_WEB_RISK_API_KEY=
#

# Browser-rendered fallback modes:
# 1 (default) = conditional fallback when static evidence is incomplete
# force = always attempt Chromium rendering (useful for local verification)
# 0 = static HTML scanning only
BACKSTOP_BROWSER_FALLBACK=1

# Local PostgreSQL. This matches docker-compose.yml.
# Override only if you run Postgres somewhere else.
DATABASE_URL=postgresql://backstop:backstop@localhost:5433/backstop
